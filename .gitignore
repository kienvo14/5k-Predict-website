# dependencies (never commit these — they're huge and re-installable)
node_modules/
frontend/node_modules/

# python
__pycache__/
*.pyc
.venv/
venv/

# build output
dist/
frontend/dist/

# large raw datasets (the app only needs features.csv, which is small)
endomondoHR*.json
*.npy
*.gz
*.parquet
preprocess_data.csv
raw-data-kaggle.csv

# ML experiment artifacts (models + generated images — regenerate from scripts)
*.pt
*.pth
*.onnx
*.pkl
notebooks/out/
notebooks/models/
notebooks/screenshots/

# sqlite database (created at runtime, holds user predictions)
*.db

# secrets — env files stay LOCAL, never in git
.env
.env.local
*.env
!.env.example

# os
.DS_Store
Thumbs.db
data/